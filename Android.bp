package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

bootstrap_go_package {
    name: "pogreb",
    pkgPath: "github.com/akrylysov/pogreb",
    srcs: [
        "bucket.go",
        "compaction.go",
        "datalog.go",
        "db.go",
        "doc.go",
        "errors.go",
        "file.go",
        "gobfile.go",
        "header.go",
        "index.go",
        "iterator.go",
        "lock.go",
        "logger.go",
        "metrics.go",
        "options.go",
        "recovery.go",
        "segment.go",
    ],
    testSrcs: [
        // TODO(b/449164878): pogreb tests fail with a read-only source tree.
        //"compaction_test.go",
        //"datalog_test.go",
        //"db_test.go",
        //"example_test.go",
        //"file_test.go",
        //"iterator_test.go",
        //"recovery_test.go",
    ],
    deps: [
        "pogreb-fs",
        "pogreb-internal-assert",
        "pogreb-internal-errors",
        "pogreb-internal-hash",
    ],
}

bootstrap_go_package {
    name: "pogreb-fs",
    pkgPath: "github.com/akrylysov/pogreb/fs",
