}

bootstrap_go_package {
    name: "pogreb-internal-errors",
    pkgPath: "github.com/akrylysov/pogreb/internal/errors",
    srcs: [
        "internal/errors/errors.go",
    ],
    testSrcs: [
        "internal/errors/errors_test.go",
    ],
