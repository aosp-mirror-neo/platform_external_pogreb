        "fs/fs.go",
        "fs/mem.go",
        "fs/os.go",
        "fs/os_mmap.go",
        "fs/os_mmap_unix.go",
        //"fs/os_mmap_windows_386.go",
        //"fs/os_mmap_windows_amd64.go",
        //"fs/os_mmap_windows.go",
        "fs/os_unix.go",
