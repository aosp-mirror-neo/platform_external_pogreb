        "fs/sub.go",
    ],
    testSrcs: [
        // TODO(b/449164878): fs tests fail with a read-only source tree.
        //"fs/fs_test.go",
        //"fs/mem_test.go",
        //"fs/os_mmap_test.go",
        //"fs/os_test.go",
        //"fs/sub_test.go",
    ],
    deps: ["pogreb-internal-assert"],
}

bootstrap_go_package {
    name: "pogreb-internal-assert",
    pkgPath: "github.com/akrylysov/pogreb/internal/assert",
    srcs: [
        "internal/assert/assert.go",
    ],
    testSrcs: [
